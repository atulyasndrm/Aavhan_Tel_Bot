# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# The public webhook URL where Telegram will send updates.
# Leave blank if using polling instead of webhooks.
WEBHOOK_URL=https://your-domain.com

# PostgreSQL connection string
# Example for local PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Example for Neon PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Telegram user ID for the admin account.
ADMIN_ID=your_personal_telegram_user_id

# Optional production settings
# LOG_LEVEL=INFO
# MAX_WORKERS=4
# REDIS_URL=redis://localhost:6379/0